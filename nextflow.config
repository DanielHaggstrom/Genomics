nextflow.enable.dsl = 2

workDir = "${projectDir}/output/work"

params {
  run_manifest = null
  runtime {
    profile = 'docker'
  }
}

process {
  executor = 'local'
  shell = ['/usr/bin/env', 'bash', '-euo', 'pipefail']
  errorStrategy = 'terminate'
}

profiles {
  docker {
    params.runtime.profile = 'docker'
  }

  test {
    params.runtime.profile = 'docker'
  }
}
