# Copy this file to config/paths.env and set real local paths.
# Keep config/paths.env out of version control.

WGS_DIR=/path/to/wgs
VCF_GZ=/path/to/wgs/DEMO_SAMPLE_001.hard-filtered.vcf.gz
VCF_TBI=/path/to/wgs/DEMO_SAMPLE_001.hard-filtered.vcf.gz.tbi
CRAM=/path/to/wgs/DEMO_SAMPLE_001.cram
CRAI=/path/to/wgs/DEMO_SAMPLE_001.cram.crai