# Copy this file to config/pipeline.env and edit values for your environment.
# This file is loaded by workflow/run_pipeline.sh.

# Required monogenic input (ClinVar-enriched VEP VCF)
SAMPLE_ID=DEMO_SAMPLE_001
ANNOTATED_VCF_GZ=/path/to/DEMO_SAMPLE_001.vep.clinvar_enriched.vcf.gz

# Stage selection defaults (1=enabled, 0=disabled)
RUN_MONOGENIC=1
RUN_PRS=1

# Monogenic tuning
MONOGENIC_MODE=moderate
MONOGENIC_MAX_AF=0.05

# PRS configuration
PRS_AUTOBUILD_SAMPLESHEET=0
PRS_SAMPLESHEET=config/prs_samplesheet.csv
PRS_PGS_IDS_FILE=config/prs_pgs_ids.txt
PGSC_PROFILE=auto
PGSC_MAX_MEMORY=14.GB
PGSC_MIN_OVERLAP=0.75
PGSC_RESUME=1