# Copy this file to config/pipeline.env and edit values for your environment.
# This file is loaded by workflow/run_pipeline.sh.

# Required monogenic sample identifier
SAMPLE_ID=DEMO_SAMPLE_001

# Monogenic input options:
# 1. Manual: point ANNOTATED_VCF_GZ at an existing VEP + ClinVar enriched VCF.
# 2. Automatic: set MONOGENIC_AUTORUN_VEP=1 and MONOGENIC_SOURCE_VCF_GZ to a
#    hard-filtered .vcf.gz; the pipeline will download/cache VEP resources and
#    create ANNOTATED_VCF_GZ if it is missing.
ANNOTATED_VCF_GZ=/path/to/DEMO_SAMPLE_001.vep.clinvar_enriched.vcf.gz
MONOGENIC_AUTORUN_VEP=0
MONOGENIC_SOURCE_VCF_GZ=/path/to/DEMO_SAMPLE_001.hard-filtered.vcf.gz
MONOGENIC_VEP_DATA_DIR=/path/to/vep_data
MONOGENIC_VEP_FORKS=8

# Stage selection defaults (1=enabled, 0=disabled)
RUN_MONOGENIC=1
RUN_PRS=1

# Monogenic tuning
MONOGENIC_MODE=moderate
MONOGENIC_MAX_AF=0.05

# PRS configuration
PRS_AUTOBUILD_SAMPLESHEET=0
PRS_SAMPLESHEET=config/prs_samplesheet.csv
PRS_PGS_IDS_FILE=config/prs_pgs_ids.txt
PGSC_PROFILE=auto
PGSC_MAX_MEMORY=14.GB
PGSC_MIN_OVERLAP=0.75
PGSC_RESUME=1
