{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genomics Run Manifest",
  "description": "Single-sample CRAM-first manifest for monogenic triage plus a PRS scaffold workflow, with optional scaffold-based imputation before scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "inputs",
    "reference",
    "analysis"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cram",
        "crai"
      ],
      "properties": {
        "cram": {
          "type": "string",
          "minLength": 1
        },
        "crai": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "called_vcf": {
          "type": "string",
          "minLength": 1
        },
        "annotated_vcf": {
          "type": "string",
          "minLength": 1
        },
        "prs_dense_vcf": {
          "type": "string",
          "minLength": 1,
          "description": "Stage-boundary import for the PRS scaffold VCF. The historical key name is retained for compatibility."
        },
        "imputed_prs_vcf": {
          "type": "string",
          "minLength": 1,
          "description": "Stage-boundary import for an imputed PRS scaffold VCF."
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "bundle_id"
      ],
      "properties": {
        "build": {
          "type": "string",
          "enum": [
            "GRCh38"
          ]
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_manifest": {
          "type": "string",
          "minLength": 1
        },
        "autodownload": {
          "type": "boolean"
        },
        "remote_decode_probe": {
          "type": "boolean"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monogenic",
        "prs"
      ],
      "properties": {
        "monogenic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": [
                "strict",
                "moderate",
                "broad"
              ]
            },
            "max_af": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "vep_forks": {
              "type": "integer",
              "minimum": 1
            },
            "workers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pairhmm_threads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "prs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "score_preset": {
              "type": "string",
              "minLength": 1
            },
            "pgs_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^PGS[0-9]{6}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "run_ancestry": {
              "type": "boolean"
            },
            "reference_db": {
              "type": [
                "string",
                "null"
              ],
              "description": "Reference database that defines the broad common-variant backbone for the PRS scaffold. The intended GRCh38 default is pgsc_HGDP+1kGP_v1."
            },
            "sample_sex": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "male",
                "female",
                null
              ]
            },
            "min_overlap": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "workers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pairhmm_threads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "imputation": {
              "type": "object",
              "additionalProperties": false,
              "description": "Optional scaffold-based PRS imputation settings. When enabled, the PRS scaffold is used as the target genome surface before scoring.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "backend": {
                  "type": "string",
                  "enum": [
                    "beagle"
                  ]
                },
                "reference_panel": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "info_threshold": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "dosage_field": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "score_preset"
                  ]
                },
                {
                  "required": [
                    "pgs_ids"
                  ]
                },
                {
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "docker"
          ]
        },
        "max_memory": {
          "type": "string",
          "minLength": 1
        },
        "max_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "min_free_gb": {
          "type": "integer",
          "minimum": 1
        },
        "linux_cache_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "results_dir": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
